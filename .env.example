# OpenAI
OPENAI_API_KEY=openai_api_key_here
# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/devsupport

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=stripe_docs

# LLM settings
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# App settings
LOG_LEVEL=INFO
ENVIRONMENT=development
